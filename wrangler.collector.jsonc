{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aboutlol-build-collector",
  "main": "workers/build-collector.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  // 승인된 Production 키를 secret으로 설정한 뒤 --env production으로 활성화한다.
  "vars": { "COLLECTOR_ENABLED": "false" },
  "d1_databases": [{
    "binding": "DB", "database_name": "kkaenam-gg",
    "database_id": "9df1655b-da71-4d23-ba2f-6c2b6981e632", "migrations_dir": "migrations"
  }],
  "env": {
    "production": {
      "name": "aboutlol-build-collector",
      "vars": { "COLLECTOR_ENABLED": "true" },
      "d1_databases": [{
        "binding": "DB", "database_name": "kkaenam-gg",
        "database_id": "9df1655b-da71-4d23-ba2f-6c2b6981e632", "migrations_dir": "migrations"
      }]
    }
  }
}
